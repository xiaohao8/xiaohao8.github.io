# Umami 反向代理示例（Nginx）
# 域名：analytics.202271.xyz（先在 DNS 添加 A 记录 → VPS IP）
# 证书：certbot 自动签发（Let's Encrypt）
#
#   sudo certbot --nginx -d analytics.202271.xyz
#
# 将下方 server 块放入 /etc/nginx/conf.d/umami.conf 后
#   sudo nginx -t && sudo nginx -s reload

server {
    listen 80;
    server_name analytics.202271.xyz;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name analytics.202271.xyz;

    # certbot 签发后路径如下（首次先注释 ssl 行用 80 端口签发）
    ssl_certificate     /etc/letsencrypt/live/analytics.202271.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/analytics.202271.xyz/privkey.pem;

    # 只允许博客域名嵌入与上报（可选，收紧来源）
    # add_header Access-Control-Allow-Origin "https://202271.xyz" always;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
